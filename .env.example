# Copy to .env (git-ignored). Never commit real credentials.

# Broker's name for spot gold (XAUUSD, XAUUSD.m, GOLD ...). Must be a gold symbol.
CI_MT5_BROKER_SYMBOL=XAUUSD

# Optional. Omit all four to attach to the MT5 terminal's current logged-in session.
# If you do set a password, use the account's INVESTOR (read-only) password:
# the broker then rejects every trade request regardless of what any software does.
# CI_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# CI_MT5_LOGIN=
# CI_MT5_PASSWORD=
# CI_MT5_SERVER=

# Local PostgreSQL from docker-compose.yml (port 5434; 5433 is used by another local project)
CI_POSTGRES_DSN=postgresql+psycopg://candle:candle@127.0.0.1:5434/candle_intelligence

# AI Assistant API mode (optional — without these the assistant runs in no-API mode
# through Claude Code / Desktop). Key lives only in .env, never in git.
# CI_LLM_PROVIDER=agentrouter
# CI_LLM_BASE_URL=https://agentrouter.org
# CI_LLM_API_KEY=
# CI_LLM_MODEL=claude-opus-5
# CI_LLM_FAST_MODEL=deepseek-v4-flash
